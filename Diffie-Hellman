import hashlib

p = 1000000007
g = 5

a = 12345
b = 67890

A = pow(g, a, p)
B = pow(g, b, p)

keyA = pow(B, a, p)
keyB = pow(A, b, p)

print("Alice Public Key:", A)
print("Bob Public Key:", B)
print("Alice Shared Key:", keyA)
print("Bob Shared Key:", keyB)
print("Keys Match:", keyA == keyB)

h = hashlib.sha256(str(keyA).encode()).hexdigest()
print("Key Hash:", h)
