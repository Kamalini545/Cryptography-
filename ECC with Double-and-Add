p = 17
a = 2
G = (5, 1)

def inv(x):
    return pow(x, -1, p)

def add(P, Q):
    if P is None:
        return Q
    if Q is None:
        return P

    x1, y1 = P
    x2, y2 = Q

    if x1 == x2 and (y1 + y2) % p == 0:
        return None

    if P == Q:
        m = (3*x1*x1 + a) * inv(2*y1) % p
    else:
        m = (y2-y1) * inv(x2-x1) % p

    x3 = (m*m-x1-x2) % p
    y3 = (m*(x1-x3)-y1) % p

    return (x3, y3)

def multiply(k, P):
    R = None

    while k:
        if k & 1:
            R = add(R, P)

        P = add(P, P)
        k >>= 1

    return R

k = 7
print("Base Point:", G)
print("k =", k)
print("kG =", multiply(k, G))
